# .env nunca vai para o git.

# --- Segredos (usados pelo auth-service) ---
JWT_SECRET=
JWT_EXPIRACAO_MINUTOS=15

CLIENTE_USUARIO=
CLIENTE_SENHA=

ATENDENTE_USUARIO=
ATENDENTE_SENHA=

# --- Somente para rodar FORA do Docker (teste local) ---
# No Docker, estes valores sao definidos no docker-compose.yml.
AUTH_URL=http://127.0.0.1:8081
ESTOQUE_URL=http://127.0.0.1:8083